<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spot_behaviors</name>
  <version>0.0.0</version>
  <description>Accumulation of behavior plugins for Spot in the BehaviorTreeCPP framework</description>
  <maintainer email="alexnavtt@utexas.edu">alex</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>spot_msgs</depend>
  <depend>spot_utils</depend>
  <depend>sensor_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>behaviortree_cpp</depend>
  <depend>moveit_ros_planning</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
